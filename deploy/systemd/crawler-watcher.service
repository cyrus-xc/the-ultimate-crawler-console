[Unit]
Description=Crawler watcher (code rules, local model for analysis only, whitelisted self-fix)
After=ultimate-crawler.service

[Service]
Type=simple
WorkingDirectory=%h/Development/the-ultimate-crawler-console
EnvironmentFile=%h/Development/the-ultimate-crawler-console/.env
# Optional: WATCHER_UNTIL=<ISO time> ends the watcher; unset, it runs permanently.
EnvironmentFile=%h/.config/crawler-watcher.env
Environment=ENABLE_TIKHUB_NETWORK=0
ExecStart=/usr/bin/node --max-old-space-size=64 tools/watcher/watcher.js
Restart=on-failure
RestartSec=30s
Nice=10
UMask=0077
MemoryHigh=96M
MemoryMax=128M

[Install]
WantedBy=default.target
