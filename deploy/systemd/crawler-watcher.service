[Unit]
Description=Read-only crawler pacing watcher (first week; exits at WATCHER_UNTIL)
After=ultimate-crawler.service

[Service]
Type=simple
WorkingDirectory=%h/Development/the-ultimate-crawler-console
EnvironmentFile=%h/Development/the-ultimate-crawler-console/.env
# Set at install time, e.g. Environment=WATCHER_UNTIL=2026-12-04T20:00:00+08:00
EnvironmentFile=%h/.config/crawler-watcher.env
Environment=ENABLE_TIKHUB_NETWORK=0
ExecStart=/usr/bin/node tools/watcher/watcher.js
Restart=on-failure
RestartSec=30s
Nice=10
UMask=0077

[Install]
WantedBy=default.target
