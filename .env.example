# Copy to .env and use absolute, private paths. Never put the service token here.
CRAWLER_PORT=18323
CRAWLER_RUNTIME_DIR=/absolute/path/to/the-ultimate-crawler-console/runtime
CRAWLER_SERVICE_TOKEN_FILE=/absolute/private/service-token
CRAWLER_XHS_WEB_ENABLED=false
CRAWLER_DOUYIN_WEB_ENABLED=false
XHS_CRAWLER_BIN=/absolute/path/to/runtime/bin/xhs-crawler
XHS_BROWSER_PROFILE=/absolute/private/xhs-profile
COOKIES_PATH=/absolute/private/xhs-cookies.json
XHS_BROWSER_CACHE=/absolute/path/to/browser-cache
CRAWLER_BROWSER_EXECUTABLE=/absolute/path/to/chrome
DOUYIN_BROWSER_PROFILE=/absolute/private/douyin-profile
CRAWLER_PYTHON=/absolute/path/to/.venv/bin/python
# Free browser collection gate; paid gates remain disabled in the service unit.
ENABLE_XHS_BROWSER_NETWORK=false
CRAWLER_DESKTOP_DEPS=/absolute/path/to/desktop-deps
CRAWLER_DESKTOP_STATE_FILE=/absolute/path/to/runtime/desktop/display.json
CRAWLER_DESKTOP_VNC_PORT=15910
CRAWLER_VNC_PORT=15910
CRAWLER_DEVICE_GATEWAY_ENABLED=false
CRAWLER_DEVICE_DISCOVERY_ENABLED=false
CRAWLER_LEGACY_ANDROID_LOCK_DIR=/absolute/path/to/existing/android-worker
CRAWLER_PHONE_ENABLED=false
CRAWLER_PHONE_CONFIG_FILE=/absolute/private/phone-config.json
# Optional exact serial allowlist, only for numeric input after INJECT_EVENTS denial.
CRAWLER_ROOT_INPUT_SERIALS=
CRAWLER_CHROME_MANIFEST_FILE=/absolute/path/to/runtime/provisioning/chrome/manifest.json
